################################################################################
# PNLCS — Panelica License & Customer System
# .env.example — 复制为 .env 并根据您的运行环境调整参数
################################################################################

# ── 基础应用配置 (Application) ────────────────────────────────────────────────
APP_NAME="PNLCS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# 默认语言：zh 为简体中文，en 为英文
APP_LOCALE=zh
APP_FALLBACK_LOCALE=zh
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── 日志记录 (Logging) ────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── 数据库 (Database - 需要 MySQL 8.0+ 或 MariaDB 10.6+) ───────────────────────
# 在执行 php artisan migrate 之前请先创建好数据库与对应用户
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pnlcs
DB_USERNAME=pnlcs
DB_PASSWORD=

# 可选：使用 Unix socket 替代 TCP 连接（若使用 TCP 请保持注释）
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# ── 会话 / 缓存 / 队列 (Session / Cache / Queue) ──────────────────────────────
# file 驱动开箱即用。生产环境且配置好 Redis 后推荐切换为 redis。
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file

# 队列驱动：sync 会在当前进程同步发送邮件与执行任务。
# 仅当有后台守护 worker（如 supervisor 运行 queue:work）时才可切换为 database 或 redis！
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ── Redis 内存缓存 (可选，当 CACHE_STORE=redis 时使用) ─────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── 邮件发送 (Mail - 生产环境建议配置真实 SMTP) ─────────────────────────────────
# 默认 log 驱动会将邮件输出到 storage/logs/laravel.log，方便调试
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Memcached (可选) ────────────────────────────────────────────────────────
MEMCACHED_HOST=127.0.0.1

# ── AWS S3 对象存储 (可选，用于云端附件与备份存储) ─────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Vite 前端构建参数 ─────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
