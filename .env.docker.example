################################################################################
# PNLCS (Panelica License & Customer System) 容器化运行环境专属配置模板
#
# 使用说明：
# 1. 复制本文件重命名为 .env：cp .env.docker.example .env
# 2. 根据您的服务器公网 IP 或域名，以及密码要求修改以下配置项
# 3. 执行 docker compose up -d 即可一键启动容器集群
################################################################################

# ==============================================================================
# 1. 基础应用配置 (Application Settings)
# ==============================================================================
# 站点/平台名称，用于浏览器标题栏、通知邮件署名等
APP_NAME="PNLCS 财务与客户系统"

# 运行环境模式：
# - production (生产模式，正式上线推荐，关闭详细报错以确保安全)
# - local (本地开发模式)
APP_ENV=production

# Laravel 32位应用密钥 (用于 Session、Cookie 及数据字段加密)
# 首次运行如果留空，可在容器启动后执行: docker exec pnlcs php artisan key:generate
APP_KEY=

# 是否开启调试模式：生产环境务必保持 false！若为 true 会泄露数据库密码等敏感信息
APP_DEBUG=false

# 系统的对外公网访问完整 URL (末尾不要带斜杠 /)
# 例如: http://192.168.1.100:8090 或 https://billing.yourdomain.com
APP_URL=http://localhost:8090

# 宿主机映射端口 (对应 docker-compose.yml 中的对外端口)
APP_PORT=8090

# 默认系统语言：zh 为简体中文，en 为英文 (默认已完全汉化)
APP_LOCALE=zh

# 后备兜底语言：当某个翻译键缺失时默认使用的语言
APP_FALLBACK_LOCALE=zh

# 测试/填充虚拟数据的语言包
APP_FAKER_LOCALE=zh_CN

# 系统维护模式驱动方式 (可选: file, cache)
APP_MAINTENANCE_DRIVER=file

# 密码哈希加密计算轮数 (推荐值 12，数字越大越安全但消耗更多 CPU)
BCRYPT_ROUNDS=12

# ==============================================================================
# 2. 日志系统配置 (Logging)
# ==============================================================================
# 日志聚合通道 (stack 表示使用组合通道)
LOG_CHANNEL=stack

# 堆栈日志轮转策略：daily 表示按天轮转分割日志，避免单个日志文件过大
LOG_STACK=daily

# 废弃特性警告通道 (设为 null 忽略)
LOG_DEPRECATIONS_CHANNEL=null

# 日志记录级别：debug, info, notice, warning, error, critical, alert, emergency
# 生产环境推荐设置为 warning 或 error
LOG_LEVEL=warning

# ==============================================================================
# 3. 数据库连接配置 (Database - MariaDB / MySQL)
# ==============================================================================
# 数据库驱动：必须为 mysql (MariaDB 亦完全兼容)
DB_CONNECTION=mysql

# 数据库主机地址：在 Docker Compose 内部网络中，直接填写容器服务名 db
DB_HOST=db

# 数据库端口：MariaDB / MySQL 默认端口 3306
DB_PORT=3306

# 业务数据库名称
DB_DATABASE=pnlcs

# 业务数据库连接用户名
DB_USERNAME=pnlcs

# 业务数据库用户密码 (建议更改为强密码)
DB_PASSWORD=pnlcs_db_password_change_me

# MariaDB root 超级管理员密码 (仅用于数据库初始化管理)
DB_ROOT_PASSWORD=pnlcs_root_password_change_me

# ==============================================================================
# 4. 会话、缓存与异步任务队列 (Session / Cache / Queue)
# ==============================================================================
# 会话驱动 (可选: file, redis, database, cookie)
# 初始化安装阶段强烈推荐使用 file 零依赖极速就绪；系统安装完成且配置好 Redis 后可随时切换为 redis
SESSION_DRIVER=file

# 会话生命周期 (单位：分钟)，120 表示 2 小时未操作自动超时
SESSION_LIFETIME=120

# 是否对会话数据进行额外加密存储
SESSION_ENCRYPT=false

# 会话有效 Cookie 作用路径
SESSION_PATH=/

# 会话有效域名 (单域名保持 null，多二级域名共享会话可填 .yourdomain.com)
SESSION_DOMAIN=null

# 缓存驱动引擎 (可选: file, redis, array)
CACHE_STORE=file

# 异步任务/队列驱动：
# - sync (同步模式：邮件和后台任务在请求内立即执行，无需单独启动 queue:work 守护进程)
# - redis (异步模式：由 Redis 处理排队，需要后台运行 queue 监听器)
# - database (数据库模式：任务记录在 jobs 表)
QUEUE_CONNECTION=sync

# 文件存储驱动 (可选: local, s3)
FILESYSTEM_DISK=local

# 广播驱动连接
BROADCAST_CONNECTION=log

# ==============================================================================
# 5. Redis 内存数据库配置 (Redis Service)
# ==============================================================================
# PHP Redis 扩展驱动客户端 (phpredis 效率最高)
REDIS_CLIENT=phpredis

# Redis 主机名：Docker Compose 内部服务名为 redis
REDIS_HOST=redis

# Redis 连接密码：若无需密码留空即可；如需设置请与 compose 对应
REDIS_PASSWORD=

# Redis 默认通信端口
REDIS_PORT=6379

# ==============================================================================
# 6. 邮件发送配置 (Mail / SMTP Configuration)
# ==============================================================================
# 邮件驱动协议：
# - smtp (生产环境必填，真实投递账单、验证码、工单通知)
# - log (测试模式：邮件内容仅写入 storage/logs/laravel.log，不实际发送)
MAIL_MAILER=smtp

MAIL_SCHEME=null

# SMTP 邮件服务器地址 (例如: smtp.exmail.qq.com 或 smtp.office365.com)
MAIL_HOST=smtp.your-email-provider.com

# SMTP 端口：通常 SSL 加密填 465，TLS/STARTTLS 填 587
MAIL_PORT=465

# SMTP 登录账号 (通常为完整邮箱地址)
MAIL_USERNAME=noreply@yourdomain.com

# SMTP 登录密码或应用专属授权码 (如 QQ/网易邮箱生成的专属授权码)
MAIL_PASSWORD=your_email_auth_token

# 邮件传输加密协议：ssl 或 tls
MAIL_ENCRYPTION=ssl

# 系统发送邮件的发件人地址 (必须与 SMTP 账户或其允许的别名一致)
MAIL_FROM_ADDRESS="noreply@yourdomain.com"

# 发件人显示名称
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# 7. 对象存储配置 (AWS S3 / 兼容S3的对象存储，可选)
# ==============================================================================
# 若 FILESYSTEM_DISK 设为 s3，用于将附件、备份存放到云存储 (如 MinIO、阿里云 OSS S3兼容模式等)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# 8. 前端构建参数 (Vite Frontend Build)
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
